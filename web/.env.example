# Copy to .env.development (local, emulators), .env.dev (`vite build --mode dev`)
# and .env.production, then fill in from Firebase console > Project settings > Your apps.
VITE_FB_API_KEY=
VITE_FB_AUTH_DOMAIN=
VITE_FB_PROJECT_ID=
VITE_FB_STORAGE_BUCKET=
VITE_FB_MESSAGING_SENDER_ID=
VITE_FB_APP_ID=
# Optional: enables App Check (reCAPTCHA v3) when not using emulators.
VITE_RECAPTCHA_SITE_KEY=
# true for local development against the Firebase emulators.
VITE_USE_EMULATORS=false
# Optional emulator port overrides (put these in .env.development.local):
# VITE_AUTH_EMULATOR_PORT=
# VITE_FIRESTORE_EMULATOR_PORT=
# VITE_FUNCTIONS_EMULATOR_PORT=
# VITE_STORAGE_EMULATOR_PORT=
